# Keep at repo root (not client/). Quote values that contain @ symbols.
DATABASE_URL=
SESSION_SECRET=

# Cross-origin clients (Electron on :5173, browser). Comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Production / packaged Electron only (remote API when UI is file:// or a CDN).
# Leave EMPTY for local dev — npm run dev and dev:electron use same-origin http://localhost:5000.
# Do not set to Vercel while developing locally (Vite bakes this at server start).
VITE_API_BASE_URL=

# Vite-only dev: proxy target when running npm run dev:client (Express must be on :5000)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Pusher realtime (required for live updates on Vercel)
PUSHER_APP_ID=
PUSHER_KEY=
# Use a `private-` channel so only session-authorized clients can subscribe
# (server /api/pusher/auth gates it). Server PUSHER_CHANNEL and client
# VITE_PUSHER_CHANNEL MUST match exactly.
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
PUSHER_CHANNEL=private-bagicha-pos
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap2
VITE_PUSHER_CHANNEL=private-bagicha-pos

# Shared secret for the generic delivery webhook (POST /api/delivery/webhook/:platform).
# Sender must present it as the `x-webhook-secret` header, or the request is rejected.
DELIVERY_WEBHOOK_SECRET=

# Electron dev
VITE_DEV_SERVER_URL=http://localhost:5173
API_BASE_URL=

# Sentry error tracking (server + client). Optional — Sentry is a no-op when unset,
# which is the default today, so production error tracking is effectively off until
# these are set in the deployment's real environment.
SENTRY_DSN=
VITE_SENTRY_DSN=
